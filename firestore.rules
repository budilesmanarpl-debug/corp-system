rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Mengizinkan baca untuk semua (untuk portal publik)
      allow read: if true;
      // Batasi tulis hanya jika ada request (bisa ditingkatkan dengan Firebase Auth nantinya)
      allow write: if true; 
    }
  }
}